# MongoDB connection string (MongoDB Atlas). Example:
# mongodb+srv://user:password@cluster0.mongodb.net/ashes-portal?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string, used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that always get admin access on signup.
ASHES_ADMIN_EMAILS=

# Production file storage. Keep the service-role key backend-only.
# New PDFs, appointment letters, invoices and uploaded client/team files are
# written to this private Supabase Storage bucket. MongoDB keeps metadata only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

NODE_ENV=production
