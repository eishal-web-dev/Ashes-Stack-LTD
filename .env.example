# MongoDB connection string (MongoDB Atlas). Example:
# mongodb+srv://user:password@cluster0.mongodb.net/ashes-portal?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string, used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that always get admin access on signup,
# regardless of signup order. Example:
# ADMIN_EMAILS=admin@gmail.com,you@yourdomain.com
ADMIN_EMAILS=
