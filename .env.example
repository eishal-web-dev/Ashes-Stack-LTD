# MongoDB connection string (MongoDB Atlas). Example:
# mongodb+srv://user:password@cluster0.mongodb.net/ashes-portal?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string, used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that always get admin access on signup,
# regardless of signup order. Example:
# ADMIN_EMAILS=admin@gmail.com,you@yourdomain.com
ADMIN_EMAILS=

# Gmail account used to send email notifications (documents sent, new
# accounts). Needs an App Password, not your normal Gmail password:
# 1. Enable 2-Step Verification on this Google account
# 2. Go to https://myaccount.google.com/apppasswords and generate one
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Sign-In ("Login with Google"). Only lets people with an
# *existing* ASHES account (created by an admin) sign in via Google —
# it does not let anyone self-register.
# Setup: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID (Web application) -> add your site's URL under
# "Authorized JavaScript origins" -> copy the Client ID.
# GOOGLE_CLIENT_ID is PUBLIC and must ALSO be set as VITE_GOOGLE_CLIENT_ID
# with the same value (Vite only exposes VITE_-prefixed vars to the browser).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
