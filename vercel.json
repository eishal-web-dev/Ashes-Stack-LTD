{
  "redirects": [
    {
      "source": "/guides/share-memory-between-chatgpt-and-claude",
      "destination": "/blog/share-context-between-chatgpt-claude-codex",
      "permanent": true
    },
    {
      "source": "/guides/connect-claude-to-mcp-server",
      "destination": "/brain/docs/claude",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp-gateway?route=mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp-gateway?route=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp-gateway?route=metadata" },
    { "source": "/oauth/authorize", "destination": "/api/mcp-gateway?route=oauth&action=authorize" },
    { "source": "/oauth/token", "destination": "/api/mcp-gateway?route=oauth&action=token" },
    { "source": "/oauth/register", "destination": "/api/mcp-gateway?route=oauth&action=register" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
